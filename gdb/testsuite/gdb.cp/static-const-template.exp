# Test printing a static constexpr member of a class template with a
# non-type template parameter.
#
# In DWARF5, GCC spells the enclosing type S<1> while the C++ expression
# evaluator looks the member up using the canonical spelling S<1l>.  The
# cooked index stores the DWARF spelling, so before the fix for PR
# symtab/33533 the lookup missed and gdb printed <optimized out>.

standard_testfile .cc

set opts {debug c++ dwarf5}
lappend opts additional_flags=-std=c++11

if {[prepare_for_testing "failed to prepare" $testfile $srcfile $opts]} {
    return
}

if {![runto_main]} {
    return
}

gdb_test "print s.v" "= 1" \
    "print static constexpr member of a template"

gdb_test "print 'S<1l>::v'" "= 1" \
    "print static constexpr member with canonical template arguments"
